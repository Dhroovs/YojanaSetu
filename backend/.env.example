APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=yojanasetu
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENABLE_DEMO_DATA=true
# Local development only. Set a random token of at least 32 characters.
ENABLE_DEV_CASE_ACCESS=false
DEV_ACCESS_TOKEN=

# Phase 2: explicitly opt in; same local token gate as case services.
ENABLE_AI=false
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=verified_schemes_v1
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=all-MiniLM-L6-v2
# none = extractive evidence-only mode, not a running LLM.
# ollama = free local model server. openai_compatible = your configured provider (may cost money).
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:3b
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
AI_TIMEOUT_SECONDS=90
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_DISTANCE=0.65
SOURCE_MAX_AGE_DAYS=365
AI_REQUESTS_PER_MINUTE=10
CONVERSATION_TTL_HOURS=24
INGESTION_MAX_BYTES=15000000
INGESTION_MAX_PAGES=150

# Phase 3: provision users through python -m app.cases.cli (no public registration).
SESSION_HOURS=8
LOGIN_ATTEMPTS_PER_MINUTE=10
DOCUMENT_STORAGE_PATH=./data/private-documents
DOCUMENT_MAX_BYTES=10000000
DOCUMENT_RETENTION_DAYS=30
CLOSED_CASE_RETENTION_DAYS=180
ENABLE_DOCUMENT_OCR=false
FOLLOW_UP_INTERVAL_HOURS=24
ESCALATION_INACTIVITY_DAYS=7
DOCUMENT_REVIEW_ESCALATION_HOURS=48
MISSING_DOCUMENT_REMINDER_LIMIT=3
ESCALATION_REOPEN_HOURS=24

# Phase 4: bounded inference; hosted calls remain disabled without explicit approval.
ALLOW_HOSTED_LLM=false
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_INPUT_CHARS=16000
LLM_MAX_OUTPUT_CHARS=16000
LLM_RETRY_LIMIT=1
SEVA_REQUESTS_PER_MINUTE=120
SEVA_NOTIFICATION_INTERVAL_HOURS=1
SEVA_RETENTION_DAYS=180
# SMS/WhatsApp have disabled adapter contracts only; no external transport is configured.
